{
  "schemaVersion": 1,
  "enabled": true,
  "runtime": {
    "command": "",
    "arguments": [],
    "workingDirectory": ".",
    "healthUrl": "",
    "environment": {},
    "inheritEnvironment": true
  },
  "supervision": {
    "autoStart": false,
    "autoRestart": true,
    "healthCheckIntervalMs": 5000,
    "healthCheckTimeoutMs": 3000,
    "maximumConsecutiveFailures": 5,
    "shutdownTimeoutMs": 8000,
    "suspendDurationMs": 600000
  },
  "restart": {
    "initialDelayMs": 1000,
    "maximumDelayMs": 30000,
    "backoffMultiplier": 2,
    "resetBackoffAfterHealthyMs": 60000
  },
  "history": {
    "maximumEvents": 2000
  },
  "security": {
    "terminateOnlyOwnedProcess": true,
    "allowShellCommand": false,
    "writePidToState": true
  }
}
