import { useMemo, useState } from "react";
import { BadgeCheck, CalendarClock, ExternalLink, FileCheck2, ImagePlus, Sparkles, Video } from "lucide-react";
import "../social-agency.css";

const thaiModernBags = {
  name: "Thai Modern Bags Co.,Ltd.",
  website: "https://www.thaimodernbags.com",
  profile: "Custom bag manufacturer · Thailand + export · Thai-first content",
  products: [
    { sku: "CAM-009", name: "กระเป๋ากล้อง CAM-009", category: "Camera bags", minimumOrder: "100–200 ใบ", productionTime: "30–45 วัน", sourceUrl: "https://www.thaimodernbags.com/รายการสินค้าและผลิตภัณฑ์กระเป๋า/กระเป๋ากล้อง/ผลิตภัณฑ์/กระเป๋ากล้อง-cam-009.html" },
    { sku: "SGB-012", name: "กระเป๋าเชือกรูด SGB-012", category: "Drawstring bags", minimumOrder: "100–200 ใบ", productionTime: "30–45 วัน", sourceUrl: "https://www.thaimodernbags.com/รายการสินค้าและผลิตภัณฑ์กระเป๋า/กระเป๋าเชือกรูด/ผลิตภัณฑ์/กระเป๋าเชือกรูด-sgb-012.html" },
  ],
};

export default function SocialAgency({ onCreateImage, onCreateVideo, onOpenChat }) {
  const [drafts, setDrafts] = useState(() => JSON.parse(localStorage.getItem("luke-social-agency-drafts") || "[]"));
  const [selectedSku, setSelectedSku] = useState(null);
  const selected = useMemo(() => thaiModernBags.products.find((product) => product.sku === selectedSku), [selectedSku]);
  const createDraft = () => {
    const recent = new Set(drafts.slice(0, 14).map((draft) => draft.sku));
    const eligible = thaiModernBags.products.filter((product) => !recent.has(product.sku));
    const product = (eligible.length ? eligible : thaiModernBags.products)[Math.floor(Math.random() * (eligible.length || thaiModernBags.products.length))];
    const draft = { id: crypto.randomUUID(), sku: product.sku, name: product.name, status: "needs-approval", createdAt: new Date().toISOString() };
    const next = [draft, ...drafts]; setDrafts(next); localStorage.setItem("luke-social-agency-drafts", JSON.stringify(next)); setSelectedSku(product.sku);
  };
  const approve = (id) => { const next = drafts.map((draft) => draft.id === id ? { ...draft, status: "approved" } : draft); setDrafts(next); localStorage.setItem("luke-social-agency-drafts", JSON.stringify(next)); };
  return <section className="social-agency-shell">
    <header className="social-agency-hero"><div><p className="social-kicker">LOCAL AI · EVIDENCE-FIRST CONTENT OPERATIONS</p><h1>Luke Social Agency</h1><p>{thaiModernBags.name} is the first client. Every social claim is traceable to a product source or approved evidence record.</p></div><button className="social-primary" onClick={createDraft}><Sparkles size={16}/> Generate today’s brief</button></header>
    <div className="social-client-card"><div><p className="social-kicker">ACTIVE CLIENT</p><h2>{thaiModernBags.name}</h2><p>{thaiModernBags.profile}</p></div><a href={thaiModernBags.website} target="_blank" rel="noreferrer">Website <ExternalLink size={14}/></a></div>
    <div className="social-stats"><article><BadgeCheck/><div><b>{thaiModernBags.products.length}</b><span>Verified product records</span></div></article><article><FileCheck2/><div><b>{drafts.filter((draft) => draft.status === "needs-approval").length}</b><span>Drafts awaiting approval</span></div></article><article><CalendarClock/><div><b>Learning</b><span>AI posting-time optimiser</span></div></article></div>
    <div className="social-grid"><section className="social-panel"><div className="social-panel-head"><div><h2>Product intelligence</h2><p>Website-sourced records eligible for content creation.</p></div></div>{thaiModernBags.products.map((product) => <button key={product.sku} className={`social-product ${selectedSku === product.sku ? "selected" : ""}`} onClick={() => setSelectedSku(product.sku)}><span>{product.sku}</span><div><b>{product.name}</b><small>{product.category} · MOQ {product.minimumOrder} · {product.productionTime}</small></div><BadgeCheck size={17}/></button>)}</section>
    <section className="social-panel"><div className="social-panel-head"><div><h2>Evidence & creative handoff</h2><p>{selected ? `${selected.name} is selected.` : "Choose a product to inspect its verified source."}</p></div></div>{selected ? <><a className="social-source" href={selected.sourceUrl} target="_blank" rel="noreferrer">Open verified product source <ExternalLink size={14}/></a><p className="social-note">Use the local LLM for a Thai caption and Reel script, then create a real-product-first visual. Do not add prices, dimensions, stock, or certifications unless present in the source evidence.</p><div className="social-actions"><button onClick={onOpenChat}><Sparkles size={15}/> Draft with local LLM</button><button onClick={onCreateImage}><ImagePlus size={15}/> Create image</button><button onClick={onCreateVideo}><Video size={15}/> Animate image</button></div></> : <p className="social-note">Select a product or create today’s non-repeating draft.</p>}</section></div>
    <section className="social-panel social-approvals"><div className="social-panel-head"><div><h2>Approval desk</h2><p>Nothing enters publishing until an owner approves it.</p></div></div>{drafts.length ? drafts.map((draft) => <div className="social-draft" key={draft.id}><div><b>{draft.name}</b><small>{draft.sku} · {new Date(draft.createdAt).toLocaleString()}</small></div><span className={draft.status}>{draft.status === "approved" ? "Approved" : "Needs approval"}</span>{draft.status === "needs-approval" && <button onClick={() => approve(draft.id)}>Approve</button>}</div>) : <p className="social-note">Generate a daily brief to create the first approval draft.</p>}</section>
  </section>;
}
