import { useMemo, useState } from "react";
import { useCallback, useEffect, useMemo, useState } from "react";
import { BadgeCheck, CalendarClock, ExternalLink, FileCheck2, ImagePlus, RefreshCw, Sparkles, Video } from "lucide-react";
import "../social-agency.css";

const api = async (url, options) => { const response = await fetch(url, options); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || "Local Social Agency runtime is unavailable."); return data; };

export default function SocialAgency({ onCreateImage, onCreateVideo, onOpenChat }) {
  const [state, setState] = useState(null); const [selectedSku, setSelectedSku] = useState(null); const [error, setError] = useState(""); const [busy, setBusy] = useState(false);
  const refresh = useCallback(async () => { try { setError(""); const data = await api("/api/social-agency/state"); setState(data.state); setSelectedSku((current) => current || data.state.products?.[0]?.sku || null); } catch (err) { setError(err.message); } }, []);
  useEffect(() => { refresh(); }, [refresh]);
  const products = state?.products || []; const drafts = state?.drafts || []; const selected = useMemo(() => products.find((product) => product.sku === selectedSku), [products, selectedSku]);
  const createDraft = async () => { setBusy(true); try { await api("/api/social-agency/daily-drafts", { method: "POST" }); await refresh(); } catch (err) { setError(err.message); } finally { setBusy(false); } };
  const updateDraft = async (id, status) => { setBusy(true); try { await api("/api/social-agency/draft-status", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id, status }) }); await refresh(); } catch (err) { setError(err.message); } finally { setBusy(false); } };
  return <section className="social-agency-shell"><header className="social-agency-hero"><div><p className="social-kicker">LOCAL AI · EVIDENCE-FIRST CONTENT OPERATIONS</p><h1>Luke Social Agency</h1><p>{state?.client?.name || "Loading local client data…"} · all products and drafts stay inside LUKE AI STUDIO.</p></div><button className="social-primary" disabled={busy} onClick={createDraft}><Sparkles size={16}/>{busy ? "Working…" : "Generate today’s brief"}</button></header>
    {error && <p className="social-note" role="alert">Local runtime: {error}</p>}
    <div className="social-client-card"><div><p className="social-kicker">ACTIVE CLIENT</p><h2>{state?.client?.name || "Thai Modern Bags Co.,Ltd."}</h2><p>Custom bag manufacturer · Thailand + export · Thai-first content</p></div><button className="social-source" onClick={refresh}><RefreshCw size={14}/> Refresh local data</button></div>
    <div className="social-stats"><article><BadgeCheck/><div><b>{products.length}</b><span>Verified product records</span></div></article><article><FileCheck2/><div><b>{drafts.filter((draft) => draft.status === "needs-approval").length}</b><span>Drafts awaiting approval</span></div></article><article><CalendarClock/><div><b>Local</b><span>Persistent approval queue</span></div></article></div>
    <div className="social-grid"><section className="social-panel"><div className="social-panel-head"><div><h2>Product intelligence</h2><p>Verified records from the local runtime.</p></div></div>{products.map((product) => <button key={product.sku} className={`social-product ${selectedSku === product.sku ? "selected" : ""}`} onClick={() => setSelectedSku(product.sku)}><span>{product.sku}</span><div><b>{product.name}</b><small>{product.category} · MOQ {product.minimumOrder} · {product.productionTime}</small></div><BadgeCheck size={17}/></button>)}</section>
    <section className="social-panel"><div className="social-panel-head"><div><h2>Evidence & creative handoff</h2><p>{selected ? `${selected.name} is selected.` : "Choose a product to inspect its evidence."}</p></div></div>{selected && <><a className="social-source" href={selected.sourceUrl} target="_blank" rel="noreferrer">Open verified product source <ExternalLink size={14}/></a><p className="social-note">Use the local LLM for a Thai caption and Reel script. Do not add prices, dimensions, stock, or certificates unless approved evidence verifies them.</p><div className="social-actions"><button onClick={onOpenChat}><Sparkles size={15}/> Draft with local LLM</button><button onClick={onCreateImage}><ImagePlus size={15}/> Create image</button><button onClick={onCreateVideo}><Video size={15}/> Animate image</button></div></>}</section></div>
    <section className="social-panel social-approvals"><div className="social-panel-head"><div><h2>Approval desk</h2><p>Persistent local drafts. Nothing enters publishing until approved.</p></div></div>{drafts.length ? drafts.map((draft) => <div className="social-draft" key={draft.id}><div><b>{draft.productName}</b><small>{draft.sku} · {new Date(draft.createdAt).toLocaleString()} · {draft.evidence}</small></div><span className={draft.status}>{draft.status === "approved" ? "Approved" : draft.status === "rejected" ? "Rejected" : "Needs approval"}</span>{draft.status === "needs-approval" && <><button disabled={busy} onClick={() => updateDraft(draft.id, "approved")}>Approve</button><button disabled={busy} onClick={() => updateDraft(draft.id, "rejected")}>Reject</button></>}</div>) : <p className="social-note">Generate a daily brief to create the first local approval draft.</p>}</section></section>;
}
