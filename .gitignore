# Models & large weights
*.gguf
*.bin
*.onnx
*.safetensors
*.pt
app/llm-models/*
app/models/*
app/openvino-models/*
app/speech-models/*
app/tts-models/*

# Heavy runtime binaries & libraries (>100MB)
*.dylib
app/tools/
app/tools/**
app/backend/mac/
app/llm-backend/mac/
app/speech-backend/mac/

# Releases & zip archives
releases/**/*.zip
releases/**/*.tar.gz
backups/

# Dependencies
node_modules/
node_modules_mac/
**/node_modules/
**/node_modules_mac/
venv/
__pycache__/

# Outputs, caches & logs
app/outputs/
app/cache/
app/tts-outputs/
app/transcriptions/
app/chat-history/
runtime-logs/
*.log
*.pid

# System & OS files
.DS_Store
.aider*
.env

# Agent skill shortcuts created by Streamlit inside the repo
.agents/
.claude/

# Social Agency connector secrets (tokens live only in this gitignored file)
app/runtime-state/social-agency/connectors.json

# macOS metadata and local workspace junk
.fseventsd/
.Spotlight-V100/
.TemporaryItems/
.Trashes/
._*
*.orig
*.rej
*.backup
*.tmp-*
thai-tts.patch*
SuperTrader/

# Local app-generated backups (runtime state snapshots created on the user machine)
*.bak-*
app/runtime-state/work-runs/
app/runtime-state/**/*.bak-*
app/runtime-state/**/*.overrides.json
app/runtime-state/**/*.local.json
# A GitHub token saved from Work: it belongs to this machine only, and must
# never travel to the repository — not even by accident.
app/runtime-state/github-auth.json
app/runtime-state/text-chat/history/

# Model Arena runs on this machine: scores, verdicts and progress. Local truth.
app/runtime-state/text-chat/arena/
# Local machine profile (RAM, chip, backend hints). Written by this machine only.
app/runtime-state/machine-profile.json

# Arena gateway key for Work mode. This machine only, never travels.
app/runtime-state/text-chat/remote-text-provider.json

# Machine state the app rewrites on every boot. Tracking these broke `git pull`
# on the user's own machine: run the app once, four tracked files change, and
# the next update is refused with "Your local changes would be overwritten by
# merge". The app recreates all four from nothing when they are absent, so
# nothing is lost by keeping them out of git.
app/runtime-state/storage/storage-availability-watcher.json
app/runtime-state/storage/storage-destination-state.json
app/runtime-state/storage/storage-provider-state.json
# Seeded at schema v1 and migrated to v2 by the app on first boot, so the
# tracked copy is stale the moment the app runs once.
app/runtime-state/social-agency/thai-modern-bags.json
# Text runtime supervision: pid, health timestamps, restart counts, event log.
# Written whenever the local runtime is started or stopped.
app/runtime-state/text-chat/runtime-supervisor.json
